{
  "name": "@awaaz/api",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "node": ">=20 <21"
  },
  "scripts": {
    "build": "nest build",
    "start": "dotenv -e ../../.env -- nest start",
    "start:dev": "dotenv -e ../../.env -- nest start --watch",
    "start:dev:no-redis": "dotenv -e ../../.env -v DISABLE_REDIS=true -- nest start --watch",
    "start:prod": "node dist/main",
    "prisma:validate": "dotenv -e ../../.env -- prisma validate",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "dotenv -e ../../.env -- prisma migrate dev",
    "prisma:status": "dotenv -e ../../.env -- prisma migrate status",
    "prisma:deploy": "dotenv -e ../../.env -- prisma migrate deploy",
    "prisma:seed": "dotenv -e ../../.env -- ts-node --files prisma/seed.ts",
    "prisma:studio": "dotenv -e ../../.env -- prisma studio",
    "bullmq:smoke": "dotenv -e ../../.env -- ts-node scripts/bullmq-smoke.ts"
  },
  "prisma": {
    "seed": "dotenv -e ../../.env -- ts-node --files prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "@clerk/backend": "^1.21.0",
    "@nestjs/bullmq": "10.2.3",
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/throttler": "^5.2.0",
    "@prisma/client": "^5.22.0",
    "bullmq": "5.30.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "ioredis": "^5.4.1",
    "livekit-server-sdk": "^2.9.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "svix": "^1.40.0",
    "twilio": "^5.3.5",
    "prisma": "^5.22.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@types/node": "^20.17.9",
    "@types/express": "^4.17.21",
    "typescript": "^5.7.2",
    "ts-node": "^10.9.2",
    "dotenv-cli": "^7.4.4"
  }
}
