# Copy to .env at repo root and fill in values (never commit .env).
# Authoritative deployment matrix: ARCHITECTURE.md + DEPLOYMENT.md

# =============================================================================
# LOCAL DEVELOPMENT (repo root .env)
# =============================================================================

# --- App ---
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
PORT=3001

# --- Supabase Postgres (Prisma) ---
# DATABASE_URL: Transaction pooler (Supavisor), port 6543.
#   Required: ?pgbouncer=true&sslmode=require&connection_limit=1
# DATABASE_DIRECT_URL: Migrations — session pooler port 5432, ?sslmode=require
DATABASE_URL=
DATABASE_DIRECT_URL=

# --- Supabase API (optional frontend flows) ---
NEXT_PUBLIC_SUPABASE_URL=
ANON_KEY=
SERVICE_ROLE_KEY=

# --- LiveKit (API + worker — same project) ---
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Must match agent dispatch and worker registration (default awaaz-agent).
LIVEKIT_AGENT_NAME=awaaz-agent
# Browser test calls: room composite egress → R2 when R2 vars are set.
LIVEKIT_BROWSER_RECORDING_ENABLED=true

# --- AI / voice (API preview endpoint + Python worker) ---
DEEPGRAM_API_KEY=
GROQ_API_KEY=
RIME_API_KEY=

# --- V2 plugin credentials (API) ---
# Generate a 32-byte encryption key for BYOK secrets:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PROVIDER_CREDENTIAL_ENCRYPTION_KEY=
# Optional Finova-managed provider keys. If omitted, V1 fallback vars above are
# still used for Rime/Groq/Deepgram so existing V1 flows remain unchanged.
FINOVA_RIME_API_KEY=
FINOVA_CARTESIA_API_KEY=
FINOVA_ELEVENLABS_API_KEY=
FINOVA_INWORLD_API_KEY=
# GPT-OSS models are served through Groq; use FINOVA_GROQ_API_KEY.
FINOVA_GROQ_API_KEY=
FINOVA_ANTHROPIC_API_KEY=
FINOVA_DEEPGRAM_API_KEY=
FINOVA_ASSEMBLYAI_API_KEY=

# --- Clerk ---
CLERK_PUBLISHABLE_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=

# --- Web → API (local: localhost; Vercel: Render API URL) ---
NEXT_PUBLIC_API_URL=http://localhost:3001

# --- Worker → API internal routes (local: localhost; Render worker: Render API URL) ---
AWAAZ_API_URL=http://localhost:3001
WORKER_SECRET=

# --- Redis (Render API only — worker does NOT use Redis) ---
# Upstash: use rediss:// for TLS
REDIS_URL=
# LOCAL ONLY: true skips BullMQ + analytics cache (avoids Upstash quota burn).
# RENDER API: omit or set false; requires healthy REDIS_URL.
DISABLE_REDIS=true

# --- Cloudflare R2 (Render API — browser recording storage) ---
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY=
CLOUDFLARE_R2_SECRET_KEY=
CLOUDFLARE_R2_BUCKET_NAME=awaaz-recordings
# Optional: public/custom-domain base URL for cached voice preview assets.
# If omitted, the API returns short-lived presigned R2 URLs for stored previews.
PUBLIC_ASSET_BASE_URL=

# --- Seed overrides (optional) ---
SIRIUS_SEED_ORG_NAME=Finova Solutions
SIRIUS_SEED_ORG_SLUG=finova-solutions
SIRIUS_SEED_CLERK_ORG_ID=
SIRIUS_SEED_OWNER_USER_ID=
SIRIUS_SEED_OWNER_EMAIL=
SIRIUS_SEED_PHONE_NUMBER=
SIRIUS_SEED_VOICE_ID=astra

# =============================================================================
# RENDER API (awaaz-api) — required unless noted
# =============================================================================
# NODE_ENV=production
# PORT=3001
# DATABASE_URL, DATABASE_DIRECT_URL, FRONTEND_URL
# CLERK_SECRET_KEY, CLERK_WEBHOOK_SECRET
# LIVEKIT_URL, LIVEKIT_API_KEY, LIVEKIT_API_SECRET, LIVEKIT_AGENT_NAME
# WORKER_SECRET, REDIS_URL (no DISABLE_REDIS)
# GROQ_API_KEY, DEEPGRAM_API_KEY, RIME_API_KEY
# CLOUDFLARE_R2_* (required for browser recordings)
# LIVEKIT_BROWSER_RECORDING_ENABLED (optional, default true)

# =============================================================================
# RENDER WORKER (awaaz-agent-worker) — required
# =============================================================================
# LIVEKIT_URL, LIVEKIT_API_KEY, LIVEKIT_API_SECRET, LIVEKIT_AGENT_NAME
# AWAAZ_API_URL, WORKER_SECRET
# DEEPGRAM_API_KEY, GROQ_API_KEY, RIME_API_KEY
# Do NOT set REDIS_URL or DISABLE_REDIS

# =============================================================================
# VERCEL (apps/web) — required
# =============================================================================
# NEXT_PUBLIC_API_URL, NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY

# =============================================================================
# WORKER TUNING (optional — apps/agent-worker only)
# =============================================================================
# LIVEKIT_VAD_MIN_SPEECH_SECONDS=0.04
# LIVEKIT_VAD_MIN_SILENCE_SECONDS=0.15
# LIVEKIT_INTERRUPT_SPEECH_SECONDS=0.35
# LIVEKIT_INTERRUPT_MIN_WORDS=1
# LIVEKIT_FINAL_PLAYBACK_DRAIN_SECONDS=0.75
# LIVEKIT_FINAL_RESPONSE_TIMEOUT_SECONDS=18
