# Copy to .env at repo root and fill in values (never commit .env).

# --- App ---
FRONTEND_URL=http://localhost:3000
PORT=3001

# --- Supabase Postgres (Prisma) ---
# DATABASE_URL: transaction pooler, port 6543 (?pgbouncer=true)
# DATABASE_DIRECT_URL: direct or session mode, port 5432 (migrations)
DATABASE_URL=
DATABASE_DIRECT_URL=

# --- Supabase API (browser vs server) ---
# Public URL for Next.js client
NEXT_PUBLIC_SUPABASE_URL=
# Server-only: use ANON_KEY for RLS-respecting client; SERVICE_ROLE_KEY bypasses RLS (admin)
ANON_KEY=
SERVICE_ROLE_KEY=

# --- LiveKit ---
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- AI / voice ---
DEEPGRAM_API_KEY=
GROQ_API_KEY=
RIME_API_KEY=

# --- Clerk (Next.js needs NEXT_PUBLIC publishable key) ---
CLERK_PUBLISHABLE_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# --- Redis (BullMQ): use redis://… URL in application code ---
REDIS_URL=

# --- Cloudflare R2 ---
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY=
CLOUDFLARE_R2_SECRET_KEY=
