# Copy to .env at repo root and fill in values (never commit .env).

# --- App ---
# Render sets this to production. Local development can omit it.
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
# API port locally; the worker health server also reads PORT in its own service environment.
PORT=3001

# --- Supabase Postgres (Prisma) ---
# DATABASE_URL: Transaction pooler (Supavisor), port 6543.
#   Required params for Prisma runtime: ?pgbouncer=true&sslmode=require&connection_limit=1
# DATABASE_DIRECT_URL: Used by Prisma migrate/introspection. On IPv4-only hosts, do NOT use
#   direct db.<project>.supabase.co unless you have Supabase IPv4 add-on. Use Session pooler instead:
#   same *.pooler.supabase.com host, port 5432, ?sslmode=require
DATABASE_URL=
DATABASE_DIRECT_URL=

# --- Supabase API (browser vs server) ---
# Public URL for Next.js client
NEXT_PUBLIC_SUPABASE_URL=
# Server-only: use ANON_KEY for RLS-respecting client; SERVICE_ROLE_KEY bypasses RLS (admin)
ANON_KEY=
SERVICE_ROLE_KEY=

# --- LiveKit ---
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Stable name matching explicit browser test dispatches (`POST …/agents/:id/test-call`) and SIP workers.
LIVEKIT_AGENT_NAME=awaaz-agent
# Browser test calls record audio via LiveKit Egress directly into R2 when R2 is configured.
LIVEKIT_BROWSER_RECORDING_ENABLED=true

# --- AI / voice ---
DEEPGRAM_API_KEY=
GROQ_API_KEY=
RIME_API_KEY=

# --- Clerk (Next.js needs NEXT_PUBLIC publishable key) ---
CLERK_PUBLISHABLE_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Clerk Dashboard → Webhooks → Signing secret (Svix). Required for POST /webhooks/clerk.
CLERK_WEBHOOK_SECRET=

# Browser calls to the Nest API (local dev: http://localhost:3001). Set on Vercel to your Render API URL.
NEXT_PUBLIC_API_URL=http://localhost:3001

# Python worker calls to internal Nest endpoints. Use the same WORKER_SECRET on API and worker services.
AWAAZ_API_URL=http://localhost:3001
WORKER_SECRET=

# --- Redis (BullMQ / Upstash): use rediss:// for TLS ---
REDIS_URL=
# Local-only escape hatch: set true to boot API without Redis-backed queues/cache.
DISABLE_REDIS=false

# --- Cloudflare R2 ---
# Phase 9 recording/preview verification depends on these.
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY=
CLOUDFLARE_R2_SECRET_KEY=
CLOUDFLARE_R2_BUCKET_NAME=awaaz-recordings

# --- Seed overrides (optional) ---
# Used by apps/api/prisma/seed.ts when creating the baseline org, owner, Sirius agent, voice, and phone number.
SIRIUS_SEED_ORG_NAME=Finova Solutions
SIRIUS_SEED_ORG_SLUG=finova-solutions
SIRIUS_SEED_CLERK_ORG_ID=
SIRIUS_SEED_OWNER_USER_ID=
SIRIUS_SEED_OWNER_EMAIL=
SIRIUS_SEED_PHONE_NUMBER=
SIRIUS_SEED_VOICE_ID=astra
