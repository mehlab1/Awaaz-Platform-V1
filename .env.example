# Copy to .env at repo root and fill in values (never commit .env).

# --- App ---
FRONTEND_URL=http://localhost:3000
PORT=3001

# --- Supabase Postgres (Prisma) ---
# DATABASE_URL: Transaction pooler (Supavisor), port 6543 — include ?pgbouncer=true (runtime / pooled queries).
# DATABASE_DIRECT_URL: Used by `prisma migrate deploy`. On IPv4-only hosts (e.g. Render builds), do NOT use
#   direct db.<project>.supabase.co unless you have Supabase IPv4 add-on — use Session pooler instead:
#   Dashboard → Connect → "Session mode" → copy URI (host *.pooler.supabase.com, port 5432).
DATABASE_URL=
DATABASE_DIRECT_URL=

# --- Supabase API (browser vs server) ---
# Public URL for Next.js client
NEXT_PUBLIC_SUPABASE_URL=
# Server-only: use ANON_KEY for RLS-respecting client; SERVICE_ROLE_KEY bypasses RLS (admin)
ANON_KEY=
SERVICE_ROLE_KEY=

# --- LiveKit ---
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- AI / voice ---
DEEPGRAM_API_KEY=
GROQ_API_KEY=
RIME_API_KEY=

# --- Clerk (Next.js needs NEXT_PUBLIC publishable key) ---
CLERK_PUBLISHABLE_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Clerk Dashboard → Webhooks → Signing secret (Svix). Required for POST /webhooks/clerk.
CLERK_WEBHOOK_SECRET=

# Browser calls to the Nest API (local dev: http://localhost:3001). Set on Vercel to your Render API URL.
NEXT_PUBLIC_API_URL=http://localhost:3001

# Python worker calls to internal Nest endpoints. Use the same WORKER_SECRET on API and worker services.
AWAAZ_API_URL=http://localhost:3001
WORKER_SECRET=

# --- Redis (BullMQ / Upstash): use rediss:// for TLS ---
REDIS_URL=

# --- Cloudflare R2 ---
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY=
CLOUDFLARE_R2_SECRET_KEY=
CLOUDFLARE_R2_BUCKET_NAME=awaaz-recordings
